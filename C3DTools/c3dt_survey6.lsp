;; Survei baca-saja: daftar reactor (object yang bergantung) tiap surface, corridor, alignment
(vl-load-com)
(defun c3dt-survey6 ( / f ss i e o nm d line inr x td typ tn)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_survey6.txt" "w"))
  (foreach typ '("AECC_TIN_SURFACE" "AECC_CORRIDOR" "AECC_ALIGNMENT")
    (setq ss (ssget "X" (list (cons 0 typ))) i 0)
    (if ss (repeat (sslength ss)
      (setq e (ssname ss i) o (vlax-ename->vla-object e) d (entget e)
            nm (vl-catch-all-apply 'vlax-get-property (list o 'Name)))
      (setq line (strcat typ ";" (cdr (assoc 5 d)) ";" (if (vl-catch-all-error-p nm) "?" nm)) inr nil)
      (foreach x d
        (cond ((and (= (car x) 102) (= (cdr x) "{ACAD_REACTORS")) (setq inr T))
              ((and (= (car x) 102) (= (cdr x) "}")) (setq inr nil))
              ((and inr (= (car x) 330))
               (setq td (entget (cdr x)))
               (setq tn (if td (strcat (cdr (assoc 0 td)) ":" (cdr (assoc 5 td))) "null"))
               (setq line (strcat line ";" tn)))))
      (write-line line f)
      (setq i (1+ i)))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY6-DONE")
  (princ))
(c3dt-survey6)
