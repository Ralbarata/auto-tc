<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin terpisah untuk command RAMBU, supaya bisa di-NETLOAD tanpa menutup Civil 3D
       (C3DTools.dll yang sudah termuat tidak bisa dimuat ulang dalam sesi yang sama). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);MSB3270;MSB3277;CS0618</NoWarn>
    <AcadDir>C:\Program Files\Autodesk\AutoCAD 2027</AcadDir>
    <!-- nama assembly baru tiap revisi supaya bisa di-NETLOAD tanpa menutup Civil 3D -->
    <AssemblyName>C3DRambuV6</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup><Compile Include="Rambu.cs" /><Compile Include="InvVol.cs" />
    <Reference Include="accoremgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>



