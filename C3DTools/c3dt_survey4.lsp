(defun c3dt-survey4 ( / f ss i e o nm r line)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_survey4.txt" "w"))
  (setq ss (ssget "X" '((0 . "AECC_ALIGNMENT"))) i 0)
  (if ss (repeat (sslength ss)
    (setq e (ssname ss i) o (vlax-ename->vla-object e)
          nm (vl-catch-all-apply 'vlax-get-property (list o 'Name)))
    (write-line (strcat "A;" (cdr (assoc 5 (entget e))) ";" (if (vl-catch-all-error-p nm) "?" nm)) f)
    (setq i (1+ i))))
  (setq ss (ssget "X" '((0 . "AECC_TIN_SURFACE"))) i 0)
  (if ss (repeat (sslength ss)
    (setq e (ssname ss i) o (vlax-ename->vla-object e)
          nm (vl-catch-all-apply 'vlax-get-property (list o 'Name)))
    (setq line (strcat "S;" (cdr (assoc 5 (entget e))) ";" (if (vl-catch-all-error-p nm) "?" nm)))
    (foreach p c3dt-pts
      (setq r (vl-catch-all-apply 'vlax-invoke (list o 'FindElevationAtXY (cadr p) (caddr p))))
      (setq line (strcat line ";" (if (vl-catch-all-error-p r) "x" (rtos r 2 3)))))
    (write-line line f)
    (setq i (1+ i))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY4-DONE")
  (princ))
(c3dt-survey4)
