;; Survei baca-saja: bbox + elevasi grid 5x5 tiap surface, bbox tiap corridor
(vl-load-com)
(defun c3dt-bb (o / r a b)
  (setq r (vl-catch-all-apply 'vla-getboundingbox (list o 'a 'b)))
  (if (vl-catch-all-error-p r) nil (list (vlax-safearray->list a) (vlax-safearray->list b))))
(defun c3dt-survey5 ( / f ss i e o nm bb line x y r ix iy typ)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_survey5.txt" "w"))
  (foreach typ '("AECC_TIN_SURFACE" "AECC_CORRIDOR")
    (setq ss (ssget "X" (list (cons 0 typ))) i 0)
    (if ss (repeat (sslength ss)
      (setq e (ssname ss i) o (vlax-ename->vla-object e)
            nm (vl-catch-all-apply 'vlax-get-property (list o 'Name))
            bb (c3dt-bb o))
      (setq line (strcat typ ";" (cdr (assoc 5 (entget e))) ";" (if (vl-catch-all-error-p nm) "?" nm) ";"
                         (if bb (strcat (rtos (car (car bb)) 2 2) ";" (rtos (cadr (car bb)) 2 2) ";"
                                        (rtos (car (cadr bb)) 2 2) ";" (rtos (cadr (cadr bb)) 2 2))
                                "nobb;;;")))
      (if (and bb (= typ "AECC_TIN_SURFACE"))
        (progn (setq ix 0)
          (repeat 5 (setq iy 0)
            (repeat 5
              (setq x (+ (car (car bb)) (* (/ (+ ix 0.5) 5.0) (- (car (cadr bb)) (car (car bb)))))
                    y (+ (cadr (car bb)) (* (/ (+ iy 0.5) 5.0) (- (cadr (cadr bb)) (cadr (car bb))))))
              (setq r (vl-catch-all-apply 'vlax-invoke (list o 'FindElevationAtXY x y)))
              (setq line (strcat line ";" (if (vl-catch-all-error-p r) "x" (rtos r 2 3))))
              (setq iy (1+ iy)))
            (setq ix (1+ ix)))))
      (write-line line f)
      (setq i (1+ i)))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY5-DONE")
  (princ))
(c3dt-survey5)
