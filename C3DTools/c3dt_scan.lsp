;; Survei baca-saja: semua entity di layer marka (model space)
(vl-load-com)
(defun c3dt-survey2 ( / f ss i e d r a b p q)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_scan_a.txt" "w"))
  (setq ss (ssget "X" '((8 . "*MARK*") (410 . "Model"))) i 0)
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) d (entget e)
            r (vl-catch-all-apply 'vla-getboundingbox (list (vlax-ename->vla-object e) 'a 'b)))
      (if (vl-catch-all-error-p r)
        (write-line (strcat "E;" (cdr (assoc 0 d)) ";" (cdr (assoc 8 d)) ";ERR") f)
        (progn
          (setq p (vlax-safearray->list a) q (vlax-safearray->list b))
          (write-line (strcat "E;" (cdr (assoc 0 d)) ";" (cdr (assoc 8 d)) ";"
                              (rtos (car p) 2 2) ";" (rtos (cadr p) 2 2) ";"
                              (rtos (car q) 2 2) ";" (rtos (cadr q) 2 2) ";"
                              (cdr (assoc 5 d))) f)))
      (setq i (1+ i))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY2-DONE")
  (princ))
(c3dt-survey2)

;; Survei baca-saja: vertex polyline 3D di layer MARKA-UTUH (tiap 40 vertex)
(defun c3dt-survey3 ( / f ss i e d v vd n pt)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_scan_b.txt" "w"))
  (setq ss (ssget "X" '((0 . "POLYLINE") (8 . "MARKA-UTUH,MARKA-PUTUS"))) i 0)
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) d (entget e) n 0)
      (write-line (strcat "P;" (cdr (assoc 5 d)) ";" (cdr (assoc 8 d)) ";flag=" (itoa (cdr (assoc 70 d)))) f)
      (setq v (entnext e))
      (while (and v (= (cdr (assoc 0 (setq vd (entget v)))) "VERTEX"))
        (if (= (rem n 40) 0)
          (progn (setq pt (cdr (assoc 10 vd)))
            (write-line (strcat "V;" (itoa n) ";" (rtos (car pt) 2 3) ";" (rtos (cadr pt) 2 3) ";" (rtos (caddr pt) 2 3)) f)))
        (setq n (1+ n) v (entnext v)))
      (write-line (strcat "N;" (itoa n)) f)
      (setq i (1+ i))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY3-DONE")
  (princ))
(c3dt-survey3)
