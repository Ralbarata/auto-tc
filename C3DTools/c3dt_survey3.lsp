;; Survei baca-saja: vertex polyline 3D di layer MARKA-UTUH (tiap 40 vertex)
(defun c3dt-survey3 ( / f ss i e d v vd n pt)
  (setq f (open "C:/Users/USER/AUTO TC by rangga/C3DTools/_survey3.txt" "w"))
  (setq ss (ssget "X" '((0 . "POLYLINE") (8 . "MARKA-UTUH"))) i 0)
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) d (entget e) n 0)
      (write-line (strcat "P;" (cdr (assoc 5 d)) ";flag=" (itoa (cdr (assoc 70 d)))) f)
      (setq v (entnext e))
      (while (and v (= (cdr (assoc 0 (setq vd (entget v)))) "VERTEX"))
        (if (= (rem n 40) 0)
          (progn (setq pt (cdr (assoc 10 vd)))
            (write-line (strcat "V;" (itoa n) ";" (rtos (car pt) 2 3) ";" (rtos (cadr pt) 2 3) ";" (rtos (caddr pt) 2 3)) f)))
        (setq n (1+ n) v (entnext v)))
      (write-line (strcat "N;" (itoa n)) f)
      (setq i (1+ i))))
  (write-line "END" f)
  (close f)
  (princ "\nSURVEY3-DONE")
  (princ))
(c3dt-survey3)
